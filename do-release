#!/bin/zsh

# Builds a universal (arm64 + x86_64) Release binary of the editor AND the VST3
# plug-in, and packages both as a .dmg
# ready to attach to a GitHub release.
#
# Versions are semver: V<major>.<minor>.<patch>-beta.<n>. The .dmg is normally
# built BEFORE the tag exists, so name the part you are bumping and the next
# version is worked out from the newest existing tag:
#
#   ./do-release beta      V0.5.0-beta.6 -> V0.5.0-beta.7   (the usual one)
#   ./do-release patch     V0.5.0-beta.6 -> V0.5.1-beta.1
#   ./do-release minor     V0.5.0-beta.6 -> V0.6.0-beta.1
#   ./do-release major     V0.5.0-beta.6 -> V1.0.0-beta.1
#   ./do-release final     V0.5.0-beta.6 -> V0.5.0           (drops -beta.n)
#
#   ./do-release 0.9.0-rc1 an explicit version, used as given
#   ./do-release           reuse the newest tag as-is (rebuild an old release)
#   ./do-release beta ~/tmp any of the above, into a different directory
#
# Under semver, 0.x.y means the interface is still unstable - so bumping to 1.0.0
# is a deliberate statement that it has settled, not just "the next big one".
#
# This script never creates or pushes the tag - it prints the git command for you
# to run once you are happy with the .dmg.
#
# The .dmg lands on the Desktop by default - outside the repo, so it is easy to
# drag onto a GitHub release and can never be committed by accident.
#
# The app is ad-hoc signed only. There is no paid Apple Developer membership
# behind this project, so the .dmg is NOT notarized and macOS will refuse to
# open it until the user clears the quarantine flag. Instructions for that are
# written into the .dmg as "Read Me First.txt" so they travel with the download.

set -e

ARG_BUMP="$1"

# Resolve a relative output path against the caller's directory, not the
# project directory we are about to switch to.
DIST="${2:-$HOME/Desktop}"
DIST="${DIST:a}"

cd ${0:a:h}

PROJECT="G2 Editor.xcodeproj"
SCHEME="G2 Editor"
APP_NAME="G2 Editor.app"
VOL_NAME="G2-Edit"
DERIVED="build/release-tmp"

# --- version -------------------------------------------------------------

# Git tags are the source of truth. MARKETING_VERSION in the project file is not
# maintained per-release and is deliberately ignored.
#
# --sort=-v:refname orders by version rather than alphabetically, so beta.10 is
# correctly newer than beta.9. --abbrev=0 on describe would give the tag nearest
# HEAD, which is not the same thing once branches are involved.
LATEST=$(git tag --list --sort=-v:refname 'V*' 2>/dev/null | head -1)
NEW_TAG=""

case "$ARG_BUMP" in
    super-major)
        # Retired name from the pre-semver scheme. Rejected rather than silently
        # treated as a literal version string, which would build "G2-Edit-super-major.dmg".
        echo "error: 'super-major' is the old name for what semver calls 'major'." >&2
        echo "       The names shifted by one when this switched to semver:" >&2
        echo "           super-major -> major     minor -> patch" >&2
        echo "           major       -> minor     beta  -> beta" >&2
        exit 1
        ;;

    major|minor|patch|beta|final)
        if [[ -z $LATEST ]]; then
            echo "error: no existing V* tag to bump from." >&2
            echo "       give an explicit version instead: ./do-release 0.1.0-beta.1" >&2
            exit 1
        fi

        # V<major>.<minor>.<patch>[-beta.<n>]
        if [[ ! $LATEST =~ '^[Vv]([0-9]+)\.([0-9]+)\.([0-9]+)(-beta\.([0-9]+))?$' ]]; then
            echo "error: newest tag '$LATEST' is not V<n>.<n>.<n>[-beta.<n>]," >&2
            echo "       so it cannot be bumped. Give an explicit version instead." >&2
            exit 1
        fi

        MAJOR=$match[1]
        MINOR=$match[2]
        PATCH=$match[3]
        BETA=$match[5]

        case "$ARG_BUMP" in
            major) (( MAJOR++ )); MINOR=0; PATCH=0; BETA=1 ;;
            minor) (( MINOR++ ));          PATCH=0; BETA=1 ;;
            patch) (( PATCH++ ));                   BETA=1 ;;
            beta)
                if [[ -z $BETA ]]; then
                    echo "error: '$LATEST' has no -beta.n to bump." >&2
                    echo "       use 'patch' to start a new beta series." >&2
                    exit 1
                fi
                (( BETA++ ))
                ;;
            final) BETA="" ;;
        esac

        if [[ -n $BETA ]]; then
            NEW_TAG="V$MAJOR.$MINOR.$PATCH-beta.$BETA"
        else
            NEW_TAG="V$MAJOR.$MINOR.$PATCH"
        fi

        if git rev-parse -q --verify "refs/tags/$NEW_TAG" >/dev/null; then
            echo "error: tag $NEW_TAG already exists." >&2
            exit 1
        fi

        VERSION="$NEW_TAG"
        echo "==> version $VERSION ($ARG_BUMP bump from $LATEST)"
        ;;

    "")
        if [[ -z $LATEST ]]; then
            echo "error: no git tag found and no version given." >&2
            echo "       try: ./do-release beta" >&2
            exit 1
        fi

        VERSION="$LATEST"
        echo "==> version $VERSION (reusing newest tag)"

        # Only meaningful when reusing an existing tag. When bumping, HEAD being
        # ahead of the previous tag is the whole point.
        if [[ -n $(git rev-list "$LATEST"..HEAD 2>/dev/null) ]]; then
            echo "    WARNING: HEAD is ahead of $LATEST - this .dmg contains code" >&2
            echo "             that is not in that tag. Did you mean ./do-release beta?" >&2
        fi
        ;;

    *)
        # An explicit version. Require it to start like one, so a mistyped keyword
        # ("bета", "pacth") is caught here instead of producing G2-Edit-pacth.dmg.
        if [[ ! $ARG_BUMP =~ '^[Vv]?[0-9]+\.' ]]; then
            echo "error: '$ARG_BUMP' is not a bump keyword or a version number." >&2
            echo "       keywords: major minor patch beta final" >&2
            echo "       or give a version: ./do-release 0.9.0-rc1" >&2
            exit 1
        fi

        VERSION="$ARG_BUMP"
        echo "==> version $VERSION (specified)"
        ;;
esac

if [[ -n $(git status --porcelain 2>/dev/null) ]]; then
    echo "    WARNING: working tree has uncommitted changes" >&2
fi

# Strip a leading V/v for filenames and the volume title: tags read "V0.5.0",
# but "G2-Edit-0.5.0.dmg" is the conventional artifact name.
VERSION_CLEAN="${VERSION#[Vv]}"

# --- build ---------------------------------------------------------------

echo "==> clean build, universal Release"

# Always build from scratch. Deleting the derived data is stronger than
# "xcodebuild clean": it also discards the module cache and any stale headers, so
# a release can never pick up something left behind by an earlier Debug build.
# Using a private -derivedDataPath keeps this away from Xcode's own build dir, so
# running this does not force a full rebuild next time you open the IDE.
rm -rf $DERIVED

xcodebuild \
    -project $PROJECT \
    -scheme $SCHEME \
    -configuration Release \
    -derivedDataPath $DERIVED \
    ARCHS="arm64 x86_64" \
    ONLY_ACTIVE_ARCH=NO \
    CODE_SIGN_IDENTITY="-" \
    CODE_SIGN_STYLE=Manual \
    DEVELOPMENT_TEAM="" \
    MARKETING_VERSION="$VERSION_CLEAN" \
    GCC_PREPROCESSOR_DEFINITIONS='$(inherited) SYNTHLIB_VERSION_STRING=\"'"$VERSION"'\"' \
    clean build

APP="$DERIVED/Build/Products/Release/$APP_NAME"

if [[ ! -d $APP ]]; then
    echo "error: build succeeded but $APP is missing" >&2
    exit 1
fi

# --- verify --------------------------------------------------------------

BINARY="$APP/Contents/MacOS/${APP_NAME:r}"
ARCHS=$(lipo -archs "$BINARY")

echo "==> built $ARCHS"

if [[ $ARCHS != *arm64* || $ARCHS != *x86_64* ]]; then
    echo "error: expected a universal binary, got '$ARCHS'" >&2
    exit 1
fi

# Confirm the version actually reached the bundle, so the .dmg name and the
# app's Get Info panel can never disagree.
PLIST_VERSION=$(defaults read "${APP:a}/Contents/Info" CFBundleShortVersionString 2>/dev/null || echo "")

if [[ $PLIST_VERSION != $VERSION_CLEAN ]]; then
    echo "error: Info.plist says '$PLIST_VERSION', expected '$VERSION_CLEAN'" >&2
    exit 1
fi

echo "==> bundle version $PLIST_VERSION"

# --- sign ----------------------------------------------------------------

# Ad-hoc signature. Not a substitute for notarization, but it keeps the bundle
# internally consistent so it launches once quarantine is cleared.
echo "==> ad-hoc signing"
xattr -cr "$APP"
codesign --force --options runtime --sign - "$APP"
codesign --verify --strict "$APP"

# --- plug-in -------------------------------------------------------------

# The VST3 ships in the same .dmg as the app. It is built by do-vst3 rather than
# by Xcode - a .vst3 is a bundle wrapped around one dylib, and it needs no build
# system to say so - so it is a separate invocation here.
#
# A MISSING SDK ABORTS THE RELEASE rather than quietly producing a .dmg with no
# plug-in in it. The .dmg's own Read Me First.txt tells the user the plug-in is
# there, so shipping one without it is worse than a build that stops and says so.
# Set G2_RELEASE_SKIP_VST3=1 for the app on its own, deliberately.

VST3_BUNDLE=""

if [[ -n ${G2_RELEASE_SKIP_VST3:-} ]]; then
    echo "==> skipping the VST3 (G2_RELEASE_SKIP_VST3 is set)"
else
    echo "==> building the VST3"

    # BUILT INSIDE THE RELEASE'S OWN TREE, not the shared build/ directory. build/ is where Xcode puts
    # its IDE products too, so an IDE build or a Clean Build Folder running alongside a release can
    # delete the bundle between do-vst3 creating it and linking into it — which is how a release failed
    # with "lipo: can't create temporary output file ... (No such file or directory)". Keeping it in
    # $DERIVED also means a release never overwrites the developer's own build/G2 Alike.vst3, which is
    # the copy normally installed for testing.
    # G2_VERSION_STRING, because do-vst3's own `git describe` would name the PREVIOUS release: the
    # tag for this one is not created until after the .dmg has been checked. See do-vst3.
    if ! G2_VERSION_STRING="$VERSION" G2_VST3_OUT="$PWD/$DERIVED/vst3/G2 Alike.vst3" ./do-vst3 >/dev/null; then
        echo "error: the VST3 build failed - see ./do-vst3 for the reason" >&2
        echo "       (needs the VST3 SDK; set VST3_SDK if it is not in ~/Documents/vst3sdk)" >&2
        echo "       set G2_RELEASE_SKIP_VST3=1 to release the app without the plug-in" >&2
        exit 1
    fi
    VST3_BUNDLE="$DERIVED/vst3/G2 Alike.vst3"

    if [[ ! -d $VST3_BUNDLE ]]; then
        echo "error: do-vst3 reported success but $VST3_BUNDLE is not there" >&2
        exit 1
    fi
    # Same universal check the app gets. A single-architecture plug-in would load
    # for half the users and be invisible to the other half.
    VST3_BINARY="$VST3_BUNDLE/Contents/MacOS/G2 Alike"
    VST3_ARCHS=$(lipo -archs "$VST3_BINARY" 2>/dev/null || echo "")

    if [[ $VST3_ARCHS != *arm64* || $VST3_ARCHS != *x86_64* ]]; then
        echo "error: the VST3 is not universal, got '$VST3_ARCHS'" >&2
        exit 1
    fi
    echo "==> VST3 built $VST3_ARCHS"
fi

# --- stage ---------------------------------------------------------------

echo "==> staging disk image contents"

STAGE=$(mktemp -d)
trap "rm -rf $STAGE" EXIT

cp -R "$APP" "$STAGE/"
ln -s /Applications "$STAGE/Applications"

# NO SYMLINK TO THE VST3 FOLDER beside the Applications one, deliberately: the
# plug-in folder lives under the user's own home directory and a symlink baked
# into a .dmg would point at the machine that built it. The Read Me First covers
# it with a Terminal line and a Finder route instead.
if [[ -n $VST3_BUNDLE ]]; then
    cp -R "$VST3_BUNDLE" "$STAGE/"
fi

cat > "$STAGE/Read Me First.txt" <<EOF
$VOL_NAME $VERSION_CLEAN
========================

WHAT IS IN HERE

  $APP_NAME     the editor
  G2 Alike.vst3      an experimental VST3 instrument that plays a patch
                     (see "THE PLUG-IN" below - install it only if you want it)

STEP 1 - INSTALL

Drag "$APP_NAME" onto the Applications folder shown in this window.

Do this before step 2. The command below refers to the app in your
Applications folder, so it only works once the app is actually there. Do not
run the app from this disk image.

STEP 2 - UNLOCK

This app is not notarized by Apple, so macOS blocks the first launch and may
claim the app is damaged. It isn't - macOS says that about any app it cannot
check with Apple.

Open Terminal (Applications > Utilities > Terminal), then copy and paste this
line exactly, including the quotes, and press Return:

    xattr -dr com.apple.quarantine "/Applications/$APP_NAME"

It prints nothing if it worked. You can now launch $APP_NAME from your
Applications folder as normal.

You only need to do this once, and again after each update.

If you installed somewhere other than Applications, change the path in the
command to match where you put the app.

Alternative, if you would rather not use Terminal: double-click the app in
Applications, dismiss the warning, then open System Settings > Privacy &
Security, scroll down, and click "Open Anyway".

THE PLUG-IN (OPTIONAL)

"G2 Alike.vst3" is a VST3 instrument that PLAYS a patch rather than editing one,
which is why it has its own name. It is experimental: it covers around 17 module
types, so many patches will load without complaint and make no sound.

The editor does not need it and it does not need the editor. Skip this section
entirely if you only want the editor.

To install it, copy it into your own VST3 folder. In Terminal:

    mkdir -p ~/Library/Audio/Plug-Ins/VST3
    cp -R "/Volumes/${${VOL_NAME}[1,15]} $VERSION_CLEAN/G2 Alike.vst3" ~/Library/Audio/Plug-Ins/VST3/
    xattr -dr com.apple.quarantine ~/Library/Audio/Plug-Ins/VST3/"G2 Alike.vst3"

Or in Finder: choose Go > Go to Folder, enter

    ~/Library/Audio/Plug-Ins/VST3

and drag "G2 Alike.vst3" from this window into it. It is unsigned in the same way
the app is, so still run the xattr line above afterwards, or your host will
refuse to load it with no useful explanation.

Then rescan plug-ins in your host - most do it at startup. It appears as
"G2 Alike" by Chris Purusha, as an instrument.

REQUIREMENTS

macOS 11.5 or later, Apple Silicon or Intel.
The plug-in needs a VST3 host; it does not work on its own.
EOF

# --- package -------------------------------------------------------------

mkdir -p $DIST
DMG="$DIST/$VOL_NAME-$VERSION_CLEAN.dmg"
rm -f "$DMG"

echo "==> creating $DMG"

# Volume names are capped at 27 characters on HFS+.
hdiutil create \
    -volname "${${VOL_NAME}[1,15]} $VERSION_CLEAN" \
    -srcfolder "$STAGE" \
    -fs HFS+ \
    -format UDZO \
    -ov \
    "$DMG" >/dev/null

echo
echo "done: $DMG ($(du -h "$DMG" | cut -f1))"
echo "architectures: $ARCHS"

if [[ -n $VST3_BUNDLE ]]; then
    echo "contents: $APP_NAME + G2 Alike.vst3 ($VST3_ARCHS)"
else
    echo "contents: $APP_NAME ONLY - no plug-in (G2_RELEASE_SKIP_VST3 was set)"
fi
echo "signature: ad-hoc, NOT notarized - users must clear quarantine"

if [[ -n $NEW_TAG ]]; then
    echo
    echo "$NEW_TAG does not exist yet. Once you are happy with the .dmg:"
    echo
    echo "    git tag -a $NEW_TAG -m \"$NEW_TAG\""
    echo "    git push origin $NEW_TAG"
fi
